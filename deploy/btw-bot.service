[Unit]
Description=btw Telegram to-do bot
After=network-online.target
Wants=network-online.target

[Service]
# Adjust User and WorkingDirectory to where you cloned the repo on the Pi.
# The bot reads .env from WorkingDirectory.
User=pi
WorkingDirectory=/home/pi/btw-telegram-bot
ExecStart=/usr/bin/python3 -m btw_bot
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
