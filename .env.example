# Copy to .env and fill in. .env is git-ignored.
# Plain KEY=value lines only: no comments after a value, no $ in values (Docker Compose reads them differently).

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot).
# Empty = anyone can use it.
BTW_ALLOWED_USERS=

# SQLite database file (relative to the working directory).
# Ignored under Docker: compose.yaml sets it to /data/btw.db, which is ./data/btw.db on the host.
BTW_DB_PATH=btw.db

# Optional: a healthchecks.io ping URL. The bot pings it at most every 5 minutes while polling Telegram works.
# Empty = no pings. See "Monitoring" in the README.
BTW_HEARTBEAT_URL=
